{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arknights-account-import",
  "account_id": "07837cee2afb94e5fd8a3b44486e1bc7",
  "d1_databases": [{
    "binding": "OPTIMIZER_DB",
    "database_name": "arknights-base-sharing",
    "database_id": "ad8da28d-4b2c-44e3-a810-ffc08bf103e9"
  }],
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ALLOWED_ORIGINS": "https://moonwhale-ko.github.io" },
  "observability": { "enabled": false },
  "ratelimits": [
    {
      "name": "MAIL_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 1, "period": 60 },
    },
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "IP_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
