{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arknights-private-admin",
  "account_id": "07837cee2afb94e5fd8a3b44486e1bc7",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "preview_urls": false,
  "observability": { "enabled": false }
}
